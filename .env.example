# Plaq-OS environment template. Copy to .env and fill in (`plaq init` does this).
# SQLite control-plane path (default: ~/.plaq/plaq.db, Windows %USERPROFILE%\.plaq)
PLAQ_DB_PATH=~/.plaq/plaq.db
# Bind address for `plaq serve`. Use 0.0.0.0 in Docker / LAN.
# PLAQ_HOST=127.0.0.1
# Comma-separated CORS allow-list, or * (default: localhost; * in Docker)
PLAQ_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8500,http://localhost:8500
# Auth is ON by default for `plaq serve`. A key is generated at
# ~/.plaq/api_key (or $PLAQ_DB_PATH/../api_key). Override or disable:
# PLAQ_API_KEY=change-me
# PLAQ_AUTH=off
# Background job queue (set off to disable the in-process worker)
# PLAQ_QUEUE=1
# LLM planner (OpenAI-compatible). Planning falls back to the
# deterministic keyword planner when unset or when the call fails.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# PLAQ_MODEL=gpt-4o
# PLAQ_LLM_PLANNING=1
